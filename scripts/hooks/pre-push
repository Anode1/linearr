#!/bin/sh
# pre-push: run both test gates and the sanitizer suite before every push, so
# a broken CLI or a memory/UB bug can't reach the remote (or turn CI red).
# Mirrors .github/workflows/sanitizers.yml.
# Enable:       make hooks           (points core.hooksPath at scripts/hooks)
# Bypass once:  git push --no-verify
set -e
root=$(git rev-parse --show-toplevel)
echo "pre-push: make check (ut + cliut + readme + java) ..."
make -C "$root" check
echo "pre-push: sanitizers (make ut-asan, ut-ubsan) ..."
make -C "$root" ut-asan
make -C "$root" ut-ubsan
echo "pre-push: clean."
